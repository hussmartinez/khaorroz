// Cloudflare Worker (static assets only) serving the Astro build.
// Deployed by .github/workflows/deploy.yml on every push to main.
// Clean URLs: files are built as /recipes/x.html and /es/index.html; "auto-trailing-slash" serves them
// at /recipes/x and /es/ and 307-redirects old /x.html links to the clean form.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "khaorice",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "arroz.forfreedom.app", "custom_domain": true }],
  "workers_dev": false,
  "observability": { "enabled": false }
}
