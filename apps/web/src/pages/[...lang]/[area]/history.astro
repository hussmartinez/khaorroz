---
// History of rice in one tradition: /spain/history (history.md), /sham/history (history_sham.md) …
// Until an area's essay exists, its page gathers the history sections of that area's own dishes.
import Layout from "../../../layouts/Layout.astro";
import Article from "../../../components/Article.astro";
import { LANGS, langParam, langBase, site, tr, HTML_LANG, DEFAULT_LANG, type Lang } from "../../../lib/site";
import { areaIds, areaView } from "../../../lib/areas";
import { graph, organization, breadcrumbs, pageUrl, abs, BRAND } from "../../../lib/seo";
import { contentDates, historyArea } from "@arros/content";
import { marked } from "marked";

export function getStaticPaths() {
  return LANGS.flatMap((lang) => areaIds().map((id) => ({ params: { lang: langParam(lang), area: id }, props: { lang, id } })));
}
const { lang, id } = Astro.props as { lang: Lang; id: string };
const m = site(lang);
const area = areaView(id, lang)!;
const page = m.pages.find((p) => p.kind === "history" && historyArea(p.file) === id);
const base = langBase(lang);
const path = `${id}/history.html`;
const url = pageUrl(lang, path);
const title = page?.title ?? tr(lang, "historyOf", { name: area.name });
const recipes = m.areas.find((a) => a.id === id)?.recipes ?? [];
const entries = page ? [] : recipes.map((r) => {
  const sec = r.body.split(/^## /m).find((s) => /^(2\.|.*Histor)/i.test(s));
  return sec ? { r, html: marked.parse(sec.split("\n").slice(1).join("\n"), { async: false }) as string } : null;
}).filter((x) => x !== null);
const dates = page ? contentDates(page.file) : undefined;
const jsonLd = graph(organization(),
  page ? { "@type": "Article", "@id": url, url, headline: page.title, description: page.summary, inLanguage: lang,
    datePublished: dates!.published, dateModified: dates!.modified, author: { "@id": `${abs("/")}#org` }, publisher: { "@id": `${abs("/")}#org` },
    image: abs(`/og/${lang}/_area-${id}.jpg`) } : { "@type": "CollectionPage", "@id": url, url, name: title, inLanguage: lang },
  breadcrumbs([[tr(lang, "home"), pageUrl(lang, "index.html")], [area.name, abs(`${base}${id}`)], [tr(lang, "navHistory"), url]]));
const crumbs: [string, string][] = [[area.name, `${base}${id}`], [tr(lang, "navHistory"), ""]];
---
<Layout lang={lang} path={path} title={title} seoTitle={`${title} | ${BRAND}`} active="history" description={page?.summary ?? area.copy.heroLede.slice(0, 150)}
        theme={area.theme} section={id} crumbs={crumbs} jsonLd={jsonLd} ogImage={{ url: `/og/${lang}/_area-${id}.jpg`, width: 1200, height: 675, alt: title }}>
  {page ? <Article p={page} m={m} kicker={`${tr(lang, "kickerHistory")} · ${area.name}`} /> : (
    <main>
      <header class="page-hero"><div class="wrap">
        <p class="kicker">{tr(lang, "kickerHistory")} · {area.name}</p>
        <h1>{title}</h1>
        <p class="lede">{entries.length ? tr(lang, "historyFallbackLede") : tr(lang, "stillResearched")}</p>
      </div></header>
      {entries.length > 0 && (
        <div class="page"><article class="prose wide">
          {entries.map(({ r, html }) => (
            <section class="history-entry" data-reveal lang={r.status === "missing" ? HTML_LANG[DEFAULT_LANG] : undefined} dir={r.status === "missing" && lang === "ar" ? "ltr" : undefined}>
              <a class="he-pan" href={`${base}${r.url}`} aria-hidden="true" tabindex="-1"><img class="pan" src={`/pans/${r.slug}.svg`} width="228" height="228" alt="" loading="lazy" decoding="async" /></a>
              <div><h2 id={r.slug}><a href={`${base}${r.url}`}>{r.title}</a></h2>{r.altTitle && <p class="alt" dir="auto">{r.altTitle}</p>}<Fragment set:html={html} /></div>
            </section>
          ))}
        </article></div>
      )}
    </main>
  )}
</Layout>
