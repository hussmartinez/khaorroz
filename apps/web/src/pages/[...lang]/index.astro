---
import Layout from "../../layouts/Layout.astro";
import HomeView from "../../components/HomeView.astro";
import { langPaths, site, tr, type Lang } from "../../lib/site";
export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const m = site(lang);
---
<Layout lang={lang} path="index.html" title={tr(lang, "siteName")} active="recipes" bodyClass="is-home" theme="spain">
  <HomeView m={m} />
</Layout>
