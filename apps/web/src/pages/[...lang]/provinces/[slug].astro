---
import Layout from "../../../layouts/Layout.astro";
import Article from "../../../components/Article.astro";
import RegionDishes from "../../../components/RegionDishes.astro";
import { LANGS, langParam, langBase, site, tr, panHtml, type Lang } from "../../../lib/site";
import { graph, organization, itemList, breadcrumbs, pageUrl, abs, regionTitle, regionDescription } from "../../../lib/seo";

export function getStaticPaths() {
  return LANGS.flatMap((lang) => site(lang).regions.map((r) => ({ params: { lang: langParam(lang), slug: r.slug }, props: { lang, file: r.file } })));
}
const { lang, file } = Astro.props as { lang: Lang; file: string };
const m = site(lang);
const r = m.regions.find((x) => x.file === file)!;
const area = m.areas.find((a) => a.id === r.area);
const crumbs: [string, string][] = [...(area ? [[area.name, `${langBase(lang)}${area.id}`] as [string, string]] : []), [r.name, ""]];
const url = pageUrl(lang, `provinces/${r.slug}.html`);
const jsonLd = graph(organization(),
  { "@type": "CollectionPage", "@id": url, url, name: r.name, inLanguage: lang, mainEntity: itemList(r.recipes, lang) },
  breadcrumbs([[tr(lang, "home"), pageUrl(lang, "index.html")], ...(area ? [[area.name, abs(`${langBase(lang)}${area.id}`)] as [string, string]] : []), [r.name, url]]));
---
<Layout lang={lang} path={`provinces/${r.slug}.html`} title={r.name} seoTitle={regionTitle(lang, r.name)} active="provinces" description={regionDescription(lang, r.name, r.recipes, r.page?.summary)}
        theme={area?.theme} crumbs={crumbs} jsonLd={jsonLd} ogImage={area ? { url: `/og/${lang}/_area-${area.id}.jpg`, width: 1200, height: 675, alt: r.name } : undefined}>
  {r.page ? (
    <Article p={r.page} m={m} kicker={tr(lang, "kickerRegion")} title={r.name}>
      {r.recipes.length > 0 && <div slot="head" class="mini-pans" aria-hidden="true" set:html={r.recipes.slice(0, 5).map((d) => `<img class="pan" src="/pans/${d.slug}.svg" width="228" height="228" alt="" loading="lazy" decoding="async">`).join("")} />}
      <RegionDishes m={m} name={r.name} list={r.recipes} />
    </Article>
  ) : (
    <main>
      <header class="page-hero"><div class="wrap"><h1>{r.name}</h1><p class="note">{tr(lang, "stillResearched")}</p></div></header>
      <RegionDishes m={m} name={r.name} list={r.recipes} />
    </main>
  )}
</Layout>
