---
// /history: one history per rice tradition — pick a section.
import Layout from "../../layouts/Layout.astro";
import { langPaths, langBase, site, tr, type Lang } from "../../lib/site";
import { graph, organization, pageUrl, BRAND } from "../../lib/seo";
import { historyArea } from "@arros/content";
export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const m = site(lang);
const base = langBase(lang);
const items = m.areas.map((a) => {
  const page = m.pages.find((p) => p.kind === "history" && historyArea(p.file) === a.id);
  return { a, title: page?.title ?? tr(lang, "historyOf", { name: a.name }), summary: page?.summary ?? (a.recipes.length ? tr(lang, "historyFallbackLede") : tr(lang, "stillResearched")) };
});
const url = pageUrl(lang, "history.html");
const jsonLd = graph(organization(), { "@type": "CollectionPage", "@id": url, url, name: tr(lang, "historyIndexTitle"), inLanguage: lang,
  hasPart: items.map((x) => ({ "@type": "WebPage", name: x.title, url: pageUrl(lang, `${x.a.id}/history.html`) })) });
---
<Layout lang={lang} path="history.html" title={tr(lang, "historyIndexTitle")} seoTitle={`${tr(lang, "historyIndexTitle")} | ${BRAND}`} active="history" jsonLd={jsonLd} theme="home">
  <main>
    <header class="page-hero"><div class="wrap">
      <p class="kicker">{tr(lang, "kickerHistory")}</p>
      <h1>{tr(lang, "historyIndexTitle")}</h1>
      <p class="lede">{tr(lang, "historyIndexLede")}</p>
    </div></header>
    <section class="doors wrap">
      {items.map(({ a, title, summary }, i) => (
        <a class={`door door-${a.theme}${a.recipes.length ? "" : " door-soon"}`} href={`${base}${a.id}/history`} data-theme={a.theme} data-reveal style={`--i:${i}`}>
          <div class="door-art door-art-short" aria-hidden="true"><span class="door-pattern"></span><span class="door-watermark">{a.theme === "sham" ? "الشام" : a.theme === "thai" ? "ข้าว" : "Arròs"}</span></div>
          <div class="door-text">
            <p class="kicker">{a.name}</p>
            <h2 dir="auto">{title}</h2>
            <p class="door-desc" dir="auto">{summary}</p>
            <span class="btn btn-primary door-cta">{tr(lang, "enter")} <span class="arrow" aria-hidden="true">→</span></span>
          </div>
        </a>
      ))}
    </section>
  </main>
</Layout>
