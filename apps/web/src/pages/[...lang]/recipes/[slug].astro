---
import Layout from "../../../layouts/Layout.astro";
import Chip from "../../../components/Chip.astro";
import Notice from "../../../components/Notice.astro";
import Related from "../../../components/Related.astro";
import RegionMap from "../../../components/RegionMap.astro";
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { facetOf, LANGS, langParam, langBase, site, renderPage, panHtml, tr, vtName, vesselLabel, provSlug, HTML_LANG, DEFAULT_LANG, isRtl, esc, type Lang } from "../../../lib/site";
import { recipeTitle, recipeDescription, recipeLD, breadcrumbs, organization, graph, pageUrl, photoFor, recipeData, abs } from "../../../lib/seo";
import { cuisinesOf } from "../../../lib/areas";

export function getStaticPaths() {
  return LANGS.flatMap((lang) => site(lang).recipes.map((p) => ({ params: { lang: langParam(lang), slug: p.slug }, props: { lang, file: p.file } })));
}
const { lang, file } = Astro.props as { lang: Lang; file: string };
const m = site(lang);
const p = m.byFile.get(file)!;
const base = langBase(lang);
const areaId = m.areaOfRecipe(p);
const area = m.areas.find((a) => a.id === areaId);
const firstRegion = p.provinces[0];
const regionLabel = firstRegion ? m.regionName(firstRegion.file, firstRegion.name) : "";
const crumbs: [string, string][] = [
  ...(area ? [[area.name, `${base}${area.id}`] as [string, string]] : []),
  ...(firstRegion ? [[regionLabel, `${base}provinces/${provSlug(firstRegion.file)}`] as [string, string]] : []),
];

// Photo (content/images.json → content/images/*.webp), optimised by astro:assets into hashed files.
const IMAGES = import.meta.glob<{ default: ImageMetadata }>("../../../../../../content/images/*.{webp,jpg,jpeg,png}", { eager: true });
const photo = photoFor(file);
const photoMeta = photo ? Object.entries(IMAGES).find(([k]) => k.endsWith("/" + photo.file.split("/").pop()))?.[1].default : undefined;
const photoAlt = photo?.alt?.[lang] ?? photo?.alt?.en ?? p.title;
const ogPhoto = photoMeta ? await getImage({ src: photoMeta, width: Math.min(1200, photoMeta.width), format: "jpeg", quality: 80 }) : undefined;
const creditInner = photo && photoMeta
  ? `${esc(tr(lang, "photo"))}: ${esc(photo.author ?? "")}${photo.license ? ` · ${photo.licenseUrl ? `<a href="${esc(photo.licenseUrl)}" rel="license noopener" target="_blank">${esc(photo.license)}</a>` : esc(photo.license)}` : ""} · ${photo.source ? `<a href="${esc(photo.source)}" target="_blank" rel="noopener">${esc(tr(lang, "viaCommons"))}</a>` : esc(tr(lang, "viaCommons"))}`
  : "";

const { headings, parts } = renderPage(p, m, { appendToSection: creditInner ? { "5": `<p class="photo-credit">${creditInner}</p>` } : {} });
const rd = recipeData(p);
const nSources = rd.sources.length;
// Tabs: the recipe first. Section numbers are language-neutral (## 1. … ## 5.).
const TABS = [["4", "recipe", "tabRecipe"], ["3", "variations", "tabVariations"], ["2", "history", "tabHistory"], ["1", "profile", "tabProfile"], ["5", "sources", "tabSources"]] as const;
const intro = parts.filter((x) => !x.num).map((x) => x.html).join("");
const known = new Set(TABS.map(([n]) => n));
const extra = parts.filter((x) => x.num && !known.has(x.num)).map((x) => x.html).join("");
const tabs = TABS.map(([n, id, key]) => ({ id, label: tr(lang, key), html: parts.filter((x) => x.num === n).map((x) => x.html).join("") + (id === "history" ? extra : ""), anchors: headings.filter((h) => h.num === n).map((h) => h.id) }))
  .filter((t) => t.html);
const facet = facetOf(m, p);
const notMissing = p.status !== "missing";

const url = pageUrl(lang, p.url);
const description = recipeDescription(p, lang, regionLabel, facetOf(m, p)?.short);
const homeUrl = pageUrl(lang, "index.html");
const jsonLd = graph(
  organization(),
  recipeLD(p, m, { facet: facetOf(m, p)?.short, url, description, photoUrl: ogPhoto ? abs(ogPhoto.src) : undefined, cuisine: cuisinesOf(p) }),
  { "@type": "WebPage", "@id": url, url, name: p.title, inLanguage: lang, isPartOf: { "@id": `${abs("/")}#website` } },
  breadcrumbs([[tr(lang, "home"), homeUrl], ...crumbs.map(([n, h]) => [n, abs(h)] as [string, string]), [p.title, url]]),
);
const ogImage = ogPhoto && photoMeta
  ? { url: abs(ogPhoto.src), width: Math.min(1200, photoMeta.width), height: Math.round((Math.min(1200, photoMeta.width) * photoMeta.height) / photoMeta.width), alt: photoAlt }
  : { url: `/og/${lang}/${p.slug}.jpg`, width: 1200, height: 675, alt: p.gloss ? `${p.title} — ${p.gloss}` : p.title };
---
<Layout lang={lang} path={p.url} title={p.title} seoTitle={recipeTitle(p, lang)} active="" description={description}
        bodyClass="is-recipe" theme={area?.theme} section={areaId} crumbs={crumbs} jsonLd={jsonLd} ogImage={ogImage}>
  <main class={`recipe base-${p.spec?.base ?? "none"}${photoMeta ? " has-photo" : ""}`} data-recipe-slug={p.slug}>
    <header class="recipe-hero">
      <div class="rh-text">
        <h1 dir="auto" class="rh-title" data-pagefind-meta="title">{p.title}</h1>
        {p.altTitle && p.altTitle !== p.title && <p dir="auto" class="alt-title">{p.altTitle}</p>}
        {p.gloss && <p dir="auto" class="gloss" data-pagefind-meta="gloss">{p.gloss}</p>}
        <Notice lang={lang} status={p.status} englishHref={p.status === "missing" ? `/${p.url}` : undefined} />
      </div>
      {photoMeta ? (
        <figure class="rh-visual rh-photo">
          <Image src={photoMeta} alt={photoAlt} widths={[480, 800, 1200, 1600].filter((w) => w <= photoMeta.width)} sizes="(max-width: 980px) 92vw, 44vw" loading="eager" fetchpriority="high" class="photo" style={`view-transition-name:${vtName("photo", p.slug)}`} />
          <div class="rh-pan-badge" style={`view-transition-name:${vtName("pan", p.slug)}`} set:html={panHtml(p, { steam: false })} />
          <figcaption set:html={creditInner} />
        </figure>
      ) : (
        <div class="rh-visual" style={`view-transition-name:${vtName("pan", p.slug)}`} set:html={panHtml(p, { cls: "hero-pan", label: true })} />
      )}
    </header>

    <section class="glance wrap" aria-label={tr(lang, "atAGlance")}>
      <dl class="glance-facts">
        <div class="glance-serves"><dt>{tr(lang, "serves")}</dt><dd>
          <span class="scaler" data-base="4">
            <button type="button" data-scale="-1" aria-label={tr(lang, "fewer")}>−</button><output aria-live="polite">4</output><button type="button" data-scale="1" aria-label={tr(lang, "more")}>+</button>
          </span>
        </dd></div>
        {rd.ingredients.length > 0 && <div><dt>{tr(lang, "ingredientsN")}</dt><dd>{rd.ingredients.length}</dd></div>}
        {rd.steps.length > 0 && <div><dt>{tr(lang, "stepsN")}</dt><dd>{rd.steps.length}</dd></div>}
        {facet && <div><dt>{tr(lang, area?.facet === "texture" ? "texture" : "category")}</dt><dd><Chip m={m} p={p} /></dd></div>}
        {p.spec && <div><dt>{tr(lang, "vessel")}</dt><dd>{vesselLabel(lang, p.spec.vessel)}</dd></div>}
        <div class="glance-where"><dt>{tr(lang, "region")}</dt><dd>{p.provinces.map((x) => <a href={`${base}provinces/${provSlug(x.file)}`}>{m.regionName(x.file, x.name)}</a>)}</dd></div>
        {nSources > 0 && <div><dt>{tr(lang, "sources")}</dt><dd><a href="#sources" data-tab-link="sources">{nSources}</a></dd></div>}
        {p.historical && <div class="glance-hist"><dt>{tr(lang, "historicalRecipe")}</dt><dd dir="auto">{p.historical}</dd></div>}
      </dl>
      <div class="glance-actions">
        <a class="btn btn-primary" href="#recipe" data-tab-link="recipe">{tr(lang, "jumpToRecipe")} <span aria-hidden="true">↓</span></a>
        <button class="btn" type="button" data-cook aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11h16v2a7 7 0 0 1-7 7h-2a7 7 0 0 1-7-7zM2 11h2M20 11h2M9 4c-1 1 1 2 0 4M13 3c-1 1 1 3 0 5"/></svg><span>{tr(lang, "cookingMode")}</span></button>
        <button class="btn btn-save" type="button" data-save={p.slug} aria-pressed="false" data-label-on={tr(lang, "savedState")} data-label-off={tr(lang, "save")}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg><span>{tr(lang, "save")}</span></button>
        <button class="btn" type="button" data-share data-copied={tr(lang, "linkCopied")}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="18" cy="5" r="2.5"/><circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="19" r="2.5"/><path d="M8.2 10.8l7.6-4.4M8.2 13.2l7.6 4.4"/></svg><span>{tr(lang, "share")}</span></button>
        <button class="btn" type="button" onclick="window.print()"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9V3h12v6M6 18H4v-7h16v7h-2M6 14h12v7H6z"/></svg><span>{tr(lang, "print")}</span></button>
      </div>
      <p class="scaled-note" hidden data-template={tr(lang, "scaledNote", { n: "{n}" })}></p>
      {area && <div class="glance-map"><RegionMap m={m} areaId={area.id} mode="locator" highlight={p.provinces.map((x) => x.file)} cls="map-mini" /></div>}
      <p class="cook-hint" hidden>{tr(lang, "cookingModeOn")} · {tr(lang, "tapToCheck")}</p>
    </section>

    {intro && <div class="wrap recipe-intro prose" set:html={intro} />}

    <div class="rtabs-bar" data-pagefind-ignore>
      <div class="wrap rtabs-inner">
        <span class="rtabs-title" dir="auto">{p.title}</span>
        <div class="rtabs" role="tablist" aria-label={p.title}>
          {tabs.map((t, i) => <a role="tab" href={`#${t.id}`} id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? "true" : "false"} data-tab={t.id}>{t.label}</a>)}
        </div>
      </div>
    </div>
    <article class="prose rpanels wrap" data-pagefind-body data-timer-label={tr(lang, "timerStart", { n: "{n}" })} lang={p.status === "missing" ? HTML_LANG[DEFAULT_LANG] : undefined} dir={p.status === "missing" && isRtl(lang) ? "ltr" : undefined}>
      {tabs.map((t) => (
        <section class="rpanel" role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} data-panel={t.id} data-anchors={t.anchors.join(" ")}>
          <span class="anchor-target" id={t.id}></span>
          <Fragment set:html={t.html} />
        </section>
      ))}
    </article>
    <Related p={p} m={m} />
  </main>
</Layout>
