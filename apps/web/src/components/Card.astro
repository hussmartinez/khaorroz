---
// Dish card: picture (photo, or the pan illustration), name, plain-language gloss, region · kind.
// The longer summary is only used for search (data-search), not shown.
import Chip from "./Chip.astro";
import { Image } from "astro:assets";
import { dishPhoto } from "../lib/photos";
import { facetOf, langBase, tr, vtName, type SiteModel, type Page } from "../lib/site";
interface Props { p: Page; m: SiteModel; i?: number }
const { p, m, i = 0 } = Astro.props;
const region = p.provinces[0] ? m.regionName(p.provinces[0].file, p.provinces[0].name) : "";
const more = p.provinces.length > 1 ? ` +${p.provinces.length - 1}` : "";
const area = m.areaOfRecipe(p);
const ph = dishPhoto(p.file, m.lang, p.title);
const theme = m.areas.find((a) => a.id === area)?.theme ?? "spain";
const facet = facetOf(m, p);
const search = `${p.title} ${p.gloss} ${p.altTitle} ${p.zone} ${p.summary}`.toLowerCase();
---
<a class={`card base-${p.spec?.base ?? "none"}${ph ? " has-photo" : ""}`} href={`${langBase(m.lang)}${p.url}`}
   style={`--i:${i % 12};view-transition-name:${vtName("card", p.slug)}`} data-reveal data-slug={p.slug}
   data-area={area} data-theme={theme} data-historical={p.historical ? "1" : undefined} data-texture={facet?.id ?? ""}
   data-facet-label={facet?.short ?? ""} data-provinces={p.provinces.map((x) => x.file).join(" ")} data-region={region}
   data-title={p.title.toLowerCase()} data-photo={ph ? "1" : "0"} data-search={search}>
  {ph ? (
    <div class="card-visual card-photo">
      <Image src={ph.meta} alt="" widths={[240, 480, 720].filter((w) => w <= ph.meta.width)} sizes="(max-width: 700px) 96px, 320px"
             loading={i < 4 ? "eager" : "lazy"} decoding="async" class="photo" style={`view-transition-name:${vtName("photo", p.slug)}`} />
    </div>
  ) : (
    <div class="card-visual" style={`view-transition-name:${vtName("pan", p.slug)}`}>
      {p.spec && <img class="pan" src={`/pans/${p.slug}.svg`} width="228" height="228" alt="" loading={i < 8 ? "eager" : "lazy"} decoding="async" />}
    </div>
  )}
  <div class="card-body">
    <h3><span dir="auto">{p.title}</span>{p.altTitle && p.altTitle !== p.title && <span class="local" dir="auto">{p.altTitle}</span>}</h3>
    {p.gloss && <p dir="auto" class="gloss">{p.gloss}</p>}
    <p class="card-meta">
      {region && <span class="where"><span class="pin" aria-hidden="true"></span>{region}{more}</span>}
      <Chip m={m} p={p} />
      {p.historical && <span class="chip chip-historical" title={p.historical}><i></i>{tr(m.lang, "historicalRecipe")}</span>}
    </p>
  </div>
</a>
