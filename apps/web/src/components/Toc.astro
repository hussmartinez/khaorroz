---
import Ad from "./Ad.astro";
import { tr, type Lang } from "../lib/site";
const { lang, headings } = Astro.props as { lang: Lang; headings: { id: string; text: string }[] };
---
{headings.length > 1 && (
  <aside class="toc" data-pagefind-ignore>
    <nav aria-label={tr(lang, "onThisPage")}>
      <p class="toc-title">{tr(lang, "onThisPage")}</p>
      <ol>{headings.map((h) => <li><a href={`#${h.id}`}>{h.text}</a></li>)}</ol>
      <Ad lang={lang} kind="sidebar" />
    </nav>
  </aside>
)}
