---
// A section (rice tradition) page: compact themed header, then the dishes with search, filters,
// grouping, sorting and grid/list view. Everything is limited to `area` and wears its theme.
import Grid from "./Grid.astro";
import Ad from "./Ad.astro";
import { langBase, tr, nDishes, panHtml, vtName, facetsFor, facetOf, type SiteModel, type AreaView, type Page } from "../lib/site";
import { dishPhoto } from "../lib/photos";

interface Props { m: SiteModel; area: AreaView }
const { m, area } = Astro.props;
const lang = m.lang;
const base = langBase(lang);
const scoped = m.areas.find((a) => a.id === area.id)!;
const recipes: Page[] = scoped.recipes;
const regions = scoped.regionList.filter((r) => r.recipes.length);
const facets = facetsFor(m, area.id).map((f) => ({ ...f, n: recipes.filter((r) => facetOf(m, r)?.id === f.id).length })).filter((f) => f.n > 0);
const isTexture = area.facet === "texture";
const PREFERRED: Record<string, string> = { spain: "paella-valenciana", sham: "maqluba", thai: "khao-man-kai" };
const heroDish = recipes.find((r) => r.slug === PREFERRED[area.id]) ?? recipes[0];
const theme = area.theme;
const WATERMARK: Record<string, string> = { spain: "Arròs", sham: "الشام", thai: "ข้าว" };
const floaters = recipes.filter((r) => r !== heroDish && r.spec && ["seco", "negro", "banda"].includes(r.spec.base)).slice(0, 4);
const photos = recipes.filter((r) => dishPhoto(r.file, lang, r.title)).length;
const hasHistorical = recipes.some((r) => r.historical);
---
<main class={`section-page area-home area-${area.id}`}>
  <section class="sec-head">
    <div class="hero-bg" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="hero-ornament" aria-hidden="true"></div>
    <div class="hero-watermark" aria-hidden="true">{WATERMARK[theme] ?? ""}</div>
    {theme === "sham" && <div class="hero-rosette" aria-hidden="true"></div>}
    {theme === "spain" && floaters.map((d, i) => <img class={`float-pan fp-${i}`} src={`/pans/${d.slug}.svg`} alt="" width="228" height="228" loading="lazy" aria-hidden="true" />)}
    <div class="sec-head-inner wrap">
      <div class="sec-head-text">
        <h1 class="sec-title" set:html={area.copy.heroTitle.replace("<br>", " ")} />
        <p class="sec-lede">{area.copy.heroLede}</p>
        {recipes.length > 0 && (
          <p class="sec-stats">
            <strong>{nDishes(lang, recipes.length)}</strong><span>·</span>
            <a href={`${base}provinces#${area.id}`}>{regions.length} {tr(lang, "navRegions").toLowerCase()}</a><span>·</span>
            <span>{tr(lang, "withPhotos", { n: photos })}</span><span>·</span>
            <a href={`${base}${area.id}/history`}>{tr(lang, "historyOf", { name: area.short })} →</a>
          </p>
        )}
      </div>
      {heroDish && <div class={`sec-head-visual hv-${theme}`} style={`view-transition-name:${vtName("pan", heroDish.slug)}`} set:html={panHtml(heroDish, { cls: "hero-pan" })} />}
    </div>
  </section>
  <div class="theme-band" aria-hidden="true"></div>

  <section class="wrap dishes-sec" id="recipes" data-one={tr(lang, "dish")} data-many={tr(lang, "dishes")}>
    {recipes.length === 0 ? <p class="note">{tr(lang, "areaSoon")}</p> : (
      <>
        <div class="toolbar">
          <label class="search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg><input type="search" id="q" placeholder={tr(lang, "searchPlaceholder")} aria-label={tr(lang, "searchLabel")} autocomplete="off"></label>
          {facets.length > 0 && (
            <div class="filters seg facet-filter" role="group" aria-label={tr(lang, isTexture ? "texture" : "category")}>
              <button type="button" data-filter-texture="" aria-pressed="true">{tr(lang, "all")} <small>{recipes.length}</small></button>
              {facets.map((f) => <button type="button" data-filter-texture={f.id} title={f.desc}><i class={`dot dot-${f.cls}`}></i>{f.short} <small>{f.n}</small></button>)}
            </div>
          )}
          <div class="filters regions-filter" role="group" aria-label={tr(lang, "region")}>
            <button type="button" data-filter-province="" aria-pressed="true">{tr(lang, "allRegions")}</button>
            {regions.map((r) => <button type="button" data-filter-province={r.file} data-area={r.area}>{r.name} <small>{r.recipes.length}</small></button>)}
            {hasHistorical && <button type="button" class="hist-toggle" data-filter-historical="1" aria-pressed="false"><span aria-hidden="true">⌛</span> {tr(lang, "historical")}</button>}
          </div>
          <div class="filter-selects">
            {facets.length > 0 && (
              <select data-select="texture" aria-label={tr(lang, isTexture ? "texture" : "category")}>
                <option value="">{tr(lang, isTexture ? "texture" : "category")}: {tr(lang, "all")}</option>
                {facets.map((f) => <option value={f.id}>{f.short} ({f.n})</option>)}
              </select>
            )}
            <select data-select="province" aria-label={tr(lang, "region")}>
              <option value="">{tr(lang, "allRegions")}</option>
              {regions.map((r) => <option value={r.file} data-area={r.area}>{r.name} ({r.recipes.length})</option>)}
            </select>
          </div>
          <div class="view-controls">
            <p class="count" id="count">{nDishes(lang, recipes.length)}</p>
            <label class="ctl"><span>{tr(lang, "groupBy")}</span>
              <select data-group aria-label={tr(lang, "groupBy")}>
                <option value="">{tr(lang, "groupNone")}</option>
                <option value="region">{tr(lang, "groupRegion")}</option>
                {facets.length > 0 && <option value="facet">{tr(lang, "groupCategory")}</option>}
              </select>
            </label>
            <label class="ctl"><span>{tr(lang, "sortBy")}</span>
              <select data-sort aria-label={tr(lang, "sortBy")}>
                <option value="az">{tr(lang, "sortAZ")}</option>
                <option value="photo">{tr(lang, "sortPhoto")}</option>
              </select>
            </label>
            <div class="view-toggle" role="group" aria-label="View">
              <button type="button" data-view="grid" aria-pressed="true" aria-label={tr(lang, "viewGrid")}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z"/></svg></button>
              <button type="button" data-view="list" aria-pressed="false" aria-label={tr(lang, "viewList")}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
            </div>
          </div>
        </div>
        <Grid list={recipes} m={m} id="grid" />
        <p class="empty" id="empty" hidden>{tr(lang, "noMatch")}</p>
      </>
    )}
  </section>
</main>
