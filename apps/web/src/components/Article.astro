---
// Generic long-form page (region, history, about): hero + optional TOC + rendered Markdown.
import Toc from "./Toc.astro";
import Notice from "./Notice.astro";
import { renderPage, HTML_LANG, DEFAULT_LANG, isRtl, type SiteModel, type Page } from "../lib/site";
interface Props { p: Page; m: SiteModel; kicker: string; title?: string }
const { p, m, kicker, title } = Astro.props;
const { html, headings } = renderPage(p, m);
---
<main>
  <header class="page-hero">
    <div class="wrap">
      <p class="kicker">{kicker}</p>
      <h1>{title ?? p.title}</h1>
      {p.altTitle && <p class="alt-title">{p.altTitle}</p>}
      <Notice lang={m.lang} status={p.status} />
      <slot name="head" />
    </div>
  </header>
  <div class={`page${headings.length > 1 ? " with-toc" : ""}`}>
    <Toc lang={m.lang} headings={headings} />
    <article class="prose" data-pagefind-body lang={p.status === "missing" ? HTML_LANG[DEFAULT_LANG] : undefined} dir={p.status === "missing" && isRtl(m.lang) ? "ltr" : undefined} set:html={html} />
  </div>
  <slot />
</main>
