---
// Classification chip: texture in Spain (seco/meloso/caldoso), the area's own category elsewhere.
import { facetOf, type SiteModel, type Page } from "../lib/site";
const { m, p } = Astro.props as { m: SiteModel; p: Page };
const f = facetOf(m, p);
---
{f && <span class={`chip chip-${f.cls}`}><i></i>{f.label}</span>}
