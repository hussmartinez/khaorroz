---
import { LANGS, HTML_LANG, langBase, tr, isRtl, site as siteModel, type Lang } from "../lib/site";
import { UI } from "../lib/i18n";
import { ADS } from "../lib/ads";
import { OG_LOCALE, abs } from "../lib/seo";
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { createHash } from "node:crypto";
// Cache-busting: link CSS/JS with a content fingerprint so a new page never pairs with a stale cached file.
const ver = (f: string) => createHash("sha256").update(readFileSync(join(process.cwd(), "public", f))).digest("hex").slice(0, 10);

interface Props {
  lang: Lang;
  path: string; // page path relative to a language root, e.g. "recipes/paella-valenciana" (".html"/"index.html" are tolerated and stripped)
  title: string;
  active: "recipes" | "history" | "provinces" | "about" | "dishes" | "credits" | "";
  description?: string;
  bodyClass?: string;
  /** Area theme id ("spain" = original look, "sham" = Shami); see style.css [data-theme]. */
  theme?: string;
  /** Breadcrumb trail above the page (area › region), each [label, href]. */
  crumbs?: [string, string][];
  /** Complete <title> (already including the brand); otherwise "{title} · {siteName}". */
  seoTitle?: string;
  /** Social card image (absolute or root-relative) — defaults to the language's home card. */
  ogImage?: { url: string; width: number; height: number; alt?: string };
  /** Area id of the current section (highlights it in the section switcher). */
  section?: string;
  /** schema.org JSON-LD object(s) for this page. */
  jsonLd?: object;
}
const { lang, path, title, active, description, bodyClass, theme = "spain", crumbs = [], seoTitle, ogImage, jsonLd, section } = Astro.props;
const sections = siteModel(lang).areas;
const base = langBase(lang);
// Clean URLs: "x.html" → "x", "index.html" / "a/index.html" → "" / "a/". Files are still built as .html;
// Cloudflare serves /x from x.html and 307-redirects old /x.html links (wrangler html_handling auto-trailing-slash).
const clean = (p: string) => p.replace(/(^|\/)index\.html$/, "$1").replace(/\.html$/, "");
const isErrorPage = path === "404.html";
const switchPath = isErrorPage ? "" : clean(path);
const site = tr(lang, "siteName");
const fullTitle = seoTitle ?? (title === site ? title : `${title} · ${site}`);
const og = ogImage ?? { url: `/og/${lang}/_home.jpg`, width: 1200, height: 675, alt: site };
const ogUrl = og.url.startsWith("http") ? og.url : abs(og.url);
const pretty = (lg: Lang) => `${langBase(lg)}${clean(path)}`;
const canonical = new URL(pretty(lang), Astro.site).href;
const nav = [
  [section ? `${section}/history` : "history", tr(lang, "navHistory"), "history"],
  [section ? `provinces#${section}` : "provinces", tr(lang, "navRegions"), "provinces"],
  ["dishes", tr(lang, "dishesAZ"), "dishes"],
  ["about", tr(lang, "navAbout"), "about"],
] as const;
---
<!doctype html>
<html lang={HTML_LANG[lang]} dir={isRtl(lang) ? "rtl" : "ltr"}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#fbf6ec" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#16120e" media="(prefers-color-scheme: dark)">
<title>{fullTitle}</title>
<meta name="description" content={description ?? tr(lang, "metaDescription")}>
{!isErrorPage && <link rel="canonical" href={canonical}>}
{!isErrorPage && LANGS.map((lg) => <link rel="alternate" hreflang={HTML_LANG[lg]} href={new URL(pretty(lg), Astro.site).href}>)}
{!isErrorPage && <link rel="alternate" hreflang="x-default" href={new URL(pretty("en"), Astro.site).href}>}
<meta property="og:title" content={fullTitle}>
<meta property="og:description" content={description ?? tr(lang, "metaDescription")}>
<meta property="og:type" content={path.startsWith("recipes/") ? "article" : "website"}>
<meta property="og:url" content={canonical}>
<meta property="og:locale" content={OG_LOCALE[lang]}>
{LANGS.filter((lg) => lg !== lang).map((lg) => <meta property="og:locale:alternate" content={OG_LOCALE[lg]}>)}
<meta property="og:site_name" content="Khaorroz">
<meta property="og:image" content={ogUrl}>
<meta property="og:image:width" content={String(og.width)}>
<meta property="og:image:height" content={String(og.height)}>
{og.alt && <meta property="og:image:alt" content={og.alt}>}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={fullTitle}>
<meta name="twitter:description" content={description ?? tr(lang, "metaDescription")}>
<meta name="twitter:image" content={ogUrl}>
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt">
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />}
<script is:inline>document.documentElement.classList.add("js")</script>
<link rel="preload" href="/fonts/fraunces-normal-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href={`/fonts.css?v=${ver("fonts.css")}`}>
<link rel="stylesheet" href={`/fonts-arabic.css?v=${ver("fonts-arabic.css")}`}>
<link rel="stylesheet" href={`/style.css?v=${ver("style.css")}`}>
{ADS.mode === "live" && ADS.head && <Fragment set:html={ADS.head} />}
</head>
<body class={bodyClass} data-theme={theme}>
<div class="progress" aria-hidden="true"></div>
<a class="skip" href="#main">↓</a>
<header class="site-header" data-pagefind-ignore>
  <a class="brand" href={base} aria-label="Khaorroz"><span class="brand-pan" aria-hidden="true"></span><span class="brand-name">Khaorroz</span></a>
  <nav class="sections" aria-label={tr(lang, "areasKicker")}>
    {sections.map((a) => (
      <a class="sec-pill" href={`${base}${a.id}`} data-theme={a.theme} aria-current={a.id === section ? "page" : undefined}>
        <span class={`sec-icon sec-icon-${a.theme}`} aria-hidden="true"></span><span class="sec-name">{a.short}</span>{a.recipes.length === 0 && <small>{tr(lang, "soon")}</small>}
      </a>
    ))}
  </nav>
  <nav class="main-nav" aria-label={tr(lang, "menu")}>
    {nav.map(([h, l, k]) => <a href={`${base}${h}`} aria-current={k === active ? "page" : undefined}>{l}</a>)}
  </nav>
  <button class="icon-btn search-btn" type="button" data-open-search aria-label={tr(lang, "search")}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg><kbd>/</kbd></button>
  <details class="lang">
    <summary aria-label={tr(lang, "language")}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/></svg><span>{UI[lang].langName}</span></summary>
    <div class="lang-menu">
      {LANGS.map((lg) => <a href={`${langBase(lg)}${switchPath}`} hreflang={HTML_LANG[lg]} lang={HTML_LANG[lg]} data-lang={lg} aria-current={lg === lang ? "true" : undefined}>{UI[lg].langName}</a>)}
    </div>
  </details>
  <button class="icon-btn menu-btn" type="button" data-open-menu aria-label={tr(lang, "menu")} aria-expanded="false" aria-controls="site-menu"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
</header>
<div class="menu-sheet" id="site-menu" hidden data-pagefind-ignore>
  <div class="menu-panel" role="dialog" aria-modal="true" aria-label={tr(lang, "menu")}>
    <div class="menu-top"><span class="brand"><span class="brand-pan" aria-hidden="true"></span>Khaorroz</span><button class="icon-btn" type="button" data-close-menu aria-label={tr(lang, "close")}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button></div>
    <button class="menu-search" type="button" data-open-search><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>{tr(lang, "searchSite")}</button>
    <p class="menu-label">{tr(lang, "areasKicker")}</p>
    <div class="menu-sections">{sections.map((a) => <a href={`${base}${a.id}`} data-theme={a.theme} aria-current={a.id === section ? "page" : undefined}><span class={`sec-icon sec-icon-${a.theme}`} aria-hidden="true"></span>{a.name}</a>)}</div>
    <div class="menu-links">{nav.map(([h, l, k]) => <a href={`${base}${h}`} aria-current={k === active ? "page" : undefined}>{l}</a>)}</div>
    <p class="menu-label">{tr(lang, "language")}</p>
    <div class="menu-langs">{LANGS.map((lg) => <a href={`${langBase(lg)}${switchPath}`} hreflang={HTML_LANG[lg]} lang={HTML_LANG[lg]} data-lang={lg} aria-current={lg === lang ? "true" : undefined}>{UI[lg].langName}</a>)}</div>
  </div>
</div>
<dialog class="search-dialog" data-pagefind-ignore data-empty={tr(lang, "searchEmpty")} aria-label={tr(lang, "search")}>
  <form method="dialog" class="sd-bar">
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
    <input type="search" name="q" placeholder={tr(lang, "searchSite")} aria-label={tr(lang, "search")} autocomplete="off" />
    <button class="icon-btn" value="close" aria-label={tr(lang, "close")}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
  </form>
  <ol class="sd-results" aria-live="polite"></ol>
</dialog>
<div id="main">
{crumbs.length > 0 && (
  <nav class="crumbs wrap" aria-label="Breadcrumb" data-pagefind-ignore>
    <ol>
      <li><a href={base}>{tr(lang, "home")}</a></li>
      {crumbs.map(([label, href], i) => <li>{i === crumbs.length - 1 && !href ? <span aria-current="page">{label}</span> : <a href={href}>{label}</a>}</li>)}
    </ol>
  </nav>
)}
<slot />
</div>
<footer class="site-footer" data-pagefind-ignore>
  <div class="footer-grid wrap">
    <div class="footer-brand">
      <span class="brand"><span class="brand-pan" aria-hidden="true"></span>Khaorroz</span>
      <p>{tr(lang, "footer1")}</p>
      <p class="small">{tr(lang, "footer2")}</p>
    </div>
    <nav aria-label={tr(lang, "footerSections")}><p class="footer-h">{tr(lang, "footerSections")}</p>{sections.map((a) => <a href={`${base}${a.id}`}>{a.name}</a>)}</nav>
    <nav aria-label={tr(lang, "footerExplore")}><p class="footer-h">{tr(lang, "footerExplore")}</p>
      <a href={`${base}history`}>{tr(lang, "navHistory")}</a><a href={`${base}provinces`}>{tr(lang, "navRegions")}</a><a href={`${base}dishes`}>{tr(lang, "dishesAZ")}</a>
    </nav>
    <nav aria-label={tr(lang, "footerProject")}><p class="footer-h">{tr(lang, "footerProject")}</p>
      <a href={`${base}about`}>{tr(lang, "navAbout")}</a><a href={`${base}credits`}>{tr(lang, "credits")}</a><a href={`${base}notes`}>{tr(lang, "notes")}</a>
      <a href="https://github.com/hussmartinez/khaorroz/issues" rel="noopener" target="_blank">{tr(lang, "corrections")}</a><a href="/llms.txt">llms.txt</a>
    </nav>
    <nav aria-label={tr(lang, "language")}><p class="footer-h">{tr(lang, "language")}</p>{LANGS.map((lg) => <a href={`${langBase(lg)}${switchPath}`} hreflang={HTML_LANG[lg]} lang={HTML_LANG[lg]}>{UI[lg].langName}</a>)}</nav>
  </div>
  <p class="small footer-bottom"><a href="#top" data-top>{tr(lang, "backToTop")} ↑</a></p>
</footer>
<div class="timers" aria-live="polite" data-done={tr(lang, "timerDone")}></div>
<script is:inline src={`/site.js?v=${ver("site.js")}`} defer></script>
</body>
</html>
